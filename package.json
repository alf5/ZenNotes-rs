{
  "name": "zennotes-rs",
  "productName": "ZenNotes-rs",
  "private": true,
  "version": "2.73.0",
  "description": "ZenNotes-rs desktop \u2014 a Tauri port of the ZenNotes markdown notes app",
  "type": "module",
  "homepage": "https://github.com/alf5/ZenNotes-rs",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "NO_STRIP=true tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mcp": "bun tooling/mcp-golden/check.ts",
    "mcp:golden": "bun tooling/mcp-golden/generate.ts"
  },
  "dependencies": {
    "@codemirror/lint": "^6.9.7",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xyflow/react": "^12.11.2",
    "@zennotes/app-core": "*",
    "@zennotes/bridge-contract": "*",
    "@zennotes/shared-domain": "*",
    "harper.js": "^2.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smol-toml": "^1.7.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^22.19.20",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
